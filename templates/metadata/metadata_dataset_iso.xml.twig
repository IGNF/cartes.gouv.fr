<?xml version="1.0" encoding="UTF-8"?><gmd:MD_Metadata xmlns:gmd="http://www.isotc211.org/2005/gmd" xmlns:gco="http://www.isotc211.org/2005/gco" xmlns:gml="http://www.opengis.net/gml" xmlns:gmx="http://www.isotc211.org/2005/gmx" xmlns:gsr="http://www.isotc211.org/2005/gsr" xmlns:gss="http://www.isotc211.org/2005/gss" xmlns:gts="http://www.isotc211.org/2005/gts" xmlns:srv="http://www.isotc211.org/2005/srv" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" {% if file_identifier is not empty %}uuid="{{ file_identifier }}" {% endif %}xsi:schemaLocation="http://www.isotc211.org/2005/gmd https://www.isotc211.org/2005/gmd/gmd.xsd http://www.isotc211.org/2005/gmx https://www.isotc211.org/2005/gmx/gmx.xsd http://www.isotc211.org/2005/srv http://schemas.opengis.net/iso/19139/20060504/srv/srv.xsd">
    {% if file_identifier is not empty %}
        <gmd:fileIdentifier>
            {# Identificateur de ressource unique #}
            <gco:CharacterString>{{ file_identifier }}</gco:CharacterString>
        </gmd:fileIdentifier>
    {% endif %}
    <gmd:language>
        <gmd:LanguageCode codeList="http://www.loc.gov/standards/iso639-2/" codeListValue="{{ language.code }}">{{ language.language }}</gmd:LanguageCode>
    </gmd:language>
    <gmd:characterSet>
        <gmd:MD_CharacterSetCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#MD_CharacterSetCode" codeListValue="{{ charset }}">{{ charset }}</gmd:MD_CharacterSetCode>
    </gmd:characterSet>
    <gmd:hierarchyLevel>
        <gmd:MD_ScopeCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#MD_ScopeCode" codeListValue="{{ hierarchy_level }}">{{ hierarchy_level }}</gmd:MD_ScopeCode>
    </gmd:hierarchyLevel>

    {# libellé du niveau hiérarchique #}
    {% set hierarchy_level_name = '' %}
    {% if hierarchy_level == 'dataset' %}
        {% set hierarchy_level_name = 'Jeu de données' %}
    {% elseif hierarchy_level == 'series' %}
        {% set hierarchy_level_name = 'Collection des données' %}
    {% endif %}

    <gmd:hierarchyLevelName>
        <gco:CharacterString>{{ hierarchy_level_name }}</gco:CharacterString>
    </gmd:hierarchyLevelName>

    {# contact des métadonnées : producteur de rôle contact, sinon le point de contact #}
    {% if producers|length %}
        {% set metadata_contact = (producers|filter(p => p.role == 'contact')|first) ?: producers|first %}
        <gmd:contact>
            {{ _self.responsible_party(metadata_contact, 'pointOfContact') }}
        </gmd:contact>
    {% endif %}

    <gmd:dateStamp>
        <gco:DateTime>{{ date_stamp }}</gco:DateTime>
    </gmd:dateStamp>

    {% if name is not empty or description is not empty or producers|length or resource_constraints|length or themes|length or keywords_inspire|length or keywords_additional|length or scale is not empty or resolution is not empty or territories|length or date_creation is not empty or thumbnail_url is not empty or update_frequency is not empty %}
        <gmd:identificationInfo>
            <gmd:MD_DataIdentification>
                {% if name is not empty %}
                    <gmd:citation>
                        <gmd:CI_Citation>
                            <gmd:title>
                                {# intitulé #}
                                <gco:CharacterString>{{ name }}</gco:CharacterString>
                            </gmd:title>

                            {% for date_type, date in {creation: date_creation, publication: date_publication, revision: date_revision}|filter(d => d is not empty) %}
                                <gmd:date>
                                    <gmd:CI_Date>
                                        <gmd:date>
                                            <gco:Date>{{ date }}</gco:Date>
                                        </gmd:date>
                                        <gmd:dateType>
                                            <gmd:CI_DateTypeCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#CI_DateTypeCode" codeListValue="{{ date_type }}">{{ date_type }}</gmd:CI_DateTypeCode>
                                        </gmd:dateType>
                                    </gmd:CI_Date>
                                </gmd:date>
                            {% endfor %}
                        </gmd:CI_Citation>
                    </gmd:citation>
                {% endif %}

                {% if description is not empty %}
                    <gmd:abstract>
                        {# résumé #}
                        <gco:CharacterString>{{ description }}</gco:CharacterString>
                    </gmd:abstract>
                {% endif %}

                {# un point de contact par producteur ; le rôle contact est écrit dans gmd:contact #}
                {% for producer in producers|filter(p => p.role != 'contact') %}
                    <gmd:pointOfContact>
                        {{ _self.responsible_party(producer, producer.role) }}
                    </gmd:pointOfContact>
                {% endfor %}

                {% if update_frequency %}
                    <gmd:resourceMaintenance>
                        <gmd:MD_MaintenanceInformation>
                            <gmd:maintenanceAndUpdateFrequency>
                                <gmd:MD_MaintenanceFrequencyCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_MaintenanceFrequencyCode" codeListValue="{{ update_frequency }}" />
                            </gmd:maintenanceAndUpdateFrequency>
                        </gmd:MD_MaintenanceInformation>
                    </gmd:resourceMaintenance>
                {% endif %}

                {% if thumbnail_url %}
                    <gmd:graphicOverview>
                        <gmd:MD_BrowseGraphic>
                            <gmd:fileName>
                                <gco:CharacterString>{{ thumbnail_url }}</gco:CharacterString>
                            </gmd:fileName>
                            <gmd:fileDescription>
                                <gco:CharacterString>Aperçu</gco:CharacterString>
                            </gmd:fileDescription>
                            <gmd:fileType>
                                <gco:CharacterString>{{ thumbnail_url|split('.')|last }}</gco:CharacterString>
                            </gmd:fileType>
                        </gmd:MD_BrowseGraphic>
                    </gmd:graphicOverview>
                {% endif %}

                {% if keywords_inspire|length %}
                    <gmd:descriptiveKeywords>
                        <gmd:MD_Keywords>
                            {%- for item in keywords_inspire -%}
                                <gmd:keyword>
                                    <gco:CharacterString>{{ item }}</gco:CharacterString>
                                </gmd:keyword>
                            {%- endfor -%}
                            <gmd:thesaurusName>
                                <gmd:CI_Citation>
                                    <gmd:title>
                                        <gco:CharacterString>GEMET - INSPIRE themes, version 1.0</gco:CharacterString>
                                    </gmd:title>
                                    <gmd:date>
                                        <gmd:CI_Date>
                                            <gmd:date>
                                                <gco:Date>2008-06-01</gco:Date>
                                            </gmd:date>
                                            <gmd:dateType>
                                                <gmd:CI_DateTypeCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode" codeListValue="publication" />
                                            </gmd:dateType>
                                        </gmd:CI_Date>
                                    </gmd:date>
                                </gmd:CI_Citation>
                            </gmd:thesaurusName>
                        </gmd:MD_Keywords>
                    </gmd:descriptiveKeywords>
                {% endif %}

                {% if keywords_additional|length %}
                    <gmd:descriptiveKeywords>
                        <gmd:MD_Keywords>
                            {%- for item in keywords_additional -%}
                                <gmd:keyword>
                                    <gco:CharacterString>{{ item }}</gco:CharacterString>
                                </gmd:keyword>
                            {%- endfor -%}
                            <gmd:type>
                                <gmd:MD_KeywordTypeCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#MD_KeywordTypeCode" codeListValue="theme">theme</gmd:MD_KeywordTypeCode>
                            </gmd:type>
                        </gmd:MD_Keywords>
                    </gmd:descriptiveKeywords>
                {% endif %}

                {# conditions d’utilisation ; sous-contraintes dans l’ordre des séquences MD_LegalConstraints et MD_SecurityConstraints #}
                {% set constraint_elements = {legal: 'gmd:MD_LegalConstraints', security: 'gmd:MD_SecurityConstraints', other: 'gmd:MD_Constraints'} %}
                {% set public_access_labels = {noLimitations: 'Aucune limitation', conditionsUnknown: 'Conditions inconnues'} %}
                {% for condition in resource_constraints %}
                    <gmd:resourceConstraints>
                        <{{ constraint_elements[condition.type] }}>
                            {% for sub in condition.constraints|filter(c => c.type == 'useLimitation') %}
                                <gmd:useLimitation>
                                    {% if sub.url is not empty %}
                                        <gmx:Anchor xlink:href="{{ sub.url }}">{{ sub.description }}</gmx:Anchor>
                                    {% else %}
                                        <gco:CharacterString>{{ sub.description }}</gco:CharacterString>
                                    {% endif %}
                                </gmd:useLimitation>
                            {% endfor %}
                            {% for restriction_type in ['accessConstraints', 'useConstraints'] %}
                                {% for sub in condition.constraints|filter(c => c.type == restriction_type) %}
                                    <gmd:{{ restriction_type }}>
                                        <gmd:MD_RestrictionCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode" codeListValue="{{ sub.restriction_code }}">{{ sub.restriction_code }}</gmd:MD_RestrictionCode>
                                    </gmd:{{ restriction_type }}>
                                {% endfor %}
                            {% endfor %}
                            {% for sub in condition.constraints|filter(c => c.type == 'otherConstraints') %}
                                <gmd:otherConstraints>
                                    {# conditionsUnknown appartient à la liste ConditionsApplyingToAccessAndUse, les autres codes à LimitationsOnPublicAccess #}
                                    {% set codelist = sub.limitation_code == 'conditionsUnknown' ? 'ConditionsApplyingToAccessAndUse' : 'LimitationsOnPublicAccess' %}
                                    <gmx:Anchor xlink:href="http://inspire.ec.europa.eu/metadata-codelist/{{ codelist }}/{{ sub.limitation_code }}">{{ public_access_labels[sub.limitation_code] ?? sub.limitation_code }}</gmx:Anchor>
                                </gmd:otherConstraints>
                            {% endfor %}
                            {% for sub in condition.constraints|filter(c => c.type == 'classification') %}
                                <gmd:classification>
                                    <gmd:MD_ClassificationCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ClassificationCode" codeListValue="{{ sub.classification_code }}">{{ sub.classification_code }}</gmd:MD_ClassificationCode>
                                </gmd:classification>
                            {% endfor %}
                        </{{ constraint_elements[condition.type] }}>
                    </gmd:resourceConstraints>
                {% endfor %}

                <gmd:spatialRepresentationType>
                    <gmd:MD_SpatialRepresentationTypeCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_SpatialRepresentationTypeCode" codeListValue="vector" />
                </gmd:spatialRepresentationType>

                {% if scale %}
                    <gmd:spatialResolution>
                        <gmd:MD_Resolution>
                            <gmd:equivalentScale>
                                <gmd:MD_RepresentativeFraction>
                                    <gmd:denominator>
                                        <gco:Integer>{{ scale }}</gco:Integer>
                                    </gmd:denominator>
                                </gmd:MD_RepresentativeFraction>
                            </gmd:equivalentScale>
                        </gmd:MD_Resolution>
                    </gmd:spatialResolution>
                {% endif %}

                {% if resolution %}
                    <gmd:spatialResolution>
                        <gmd:MD_Resolution>
                            <gmd:distance>
                                <gco:Distance uom="m">{{ resolution }}</gco:Distance>
                            </gmd:distance>
                        </gmd:MD_Resolution>
                    </gmd:spatialResolution>
                {% endif %}

                {# langue de la ressource, obligatoire dans MD_DataIdentification #}
                <gmd:language>
                    <gmd:LanguageCode codeList="http://www.loc.gov/standards/iso639-2/" codeListValue="{{ language.code }}">{{ language.language }}</gmd:LanguageCode>
                </gmd:language>

                {% for topic in themes %}
                    <gmd:topicCategory>
                        <gmd:MD_TopicCategoryCode>{{ topic }}</gmd:MD_TopicCategoryCode>
                    </gmd:topicCategory>
                {% endfor %}

                {# une emprise par territoire : libellé, rectangle WGS84 et identifiant géographique (BD TOPO ou code commune) #}
                {% for territory in territories %}
                    <gmd:extent>
                        <gmd:EX_Extent>
                            <gmd:description>
                                <gco:CharacterString>{{ territory.title }}</gco:CharacterString>
                            </gmd:description>
                            <gmd:geographicElement>
                                <gmd:EX_GeographicBoundingBox>
                                    <gmd:westBoundLongitude>
                                        <gco:Decimal>{{ territory.bbox[0] }}</gco:Decimal>
                                    </gmd:westBoundLongitude>
                                    <gmd:eastBoundLongitude>
                                        <gco:Decimal>{{ territory.bbox[2] }}</gco:Decimal>
                                    </gmd:eastBoundLongitude>
                                    <gmd:southBoundLatitude>
                                        <gco:Decimal>{{ territory.bbox[1] }}</gco:Decimal>
                                    </gmd:southBoundLatitude>
                                    <gmd:northBoundLatitude>
                                        <gco:Decimal>{{ territory.bbox[3] }}</gco:Decimal>
                                    </gmd:northBoundLatitude>
                                </gmd:EX_GeographicBoundingBox>
                            </gmd:geographicElement>
                            <gmd:geographicElement>
                                <gmd:EX_GeographicDescription>
                                    <gmd:geographicIdentifier>
                                        <gmd:MD_Identifier>
                                            <gmd:code>
                                                <gco:CharacterString>{{ territory.id }}</gco:CharacterString>
                                            </gmd:code>
                                        </gmd:MD_Identifier>
                                    </gmd:geographicIdentifier>
                                </gmd:EX_GeographicDescription>
                            </gmd:geographicElement>
                        </gmd:EX_Extent>
                    </gmd:extent>
                {% endfor %}

            </gmd:MD_DataIdentification>
        </gmd:identificationInfo>
    {% endif %}

    {% if online_resources|length %}
        <gmd:distributionInfo>
            <gmd:MD_Distribution>
                <gmd:transferOptions>
                    <gmd:MD_DigitalTransferOptions>
                        {# https://cnig.gouv.fr/IMG/pdf/guide_recherche_inspire.pdf #}
                        {# linkage : adresse de la ressource ; protocol : nature de la ressource (OGC:WMS, OGC:WFS, OGC:WMTS, TMS pour une couche ; vocabulaire OSGeo pour les fichiers) ; name : nom de la couche ou du fichier #}
                        {% set functions = {style: 'download', capabilities: 'information', document: 'information'} %}
                        {% for resource in online_resources %}
                            <gmd:onLine>
                                <gmd:CI_OnlineResource>
                                    <gmd:linkage>
                                        <gmd:URL>{{ resource.url }}</gmd:URL>
                                    </gmd:linkage>
                                    {% if resource.protocol is not empty %}
                                        <gmd:protocol>
                                            <gco:CharacterString>{{ resource.protocol }}</gco:CharacterString>
                                        </gmd:protocol>
                                    {% endif %}
                                    {% if resource.type == 'layer' and not resource.open %}
                                        <gmd:applicationProfile>
                                            <gmx:Anchor xlink:href="http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/other">other</gmx:Anchor>
                                        </gmd:applicationProfile>
                                    {% endif %}
                                    {% if resource.name is not empty %}
                                        <gmd:name>
                                            <gco:CharacterString>{{ resource.name }}</gco:CharacterString>
                                        </gmd:name>
                                    {% endif %}
                                    {% if resource.type == 'layer' and not resource.open %}
                                        <gmd:description>
                                            <gmx:Anchor xlink:href="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode_restricted">{{ resource.description ?: resource.name ~ ' - Accès restreint' }}</gmx:Anchor>
                                        </gmd:description>
                                    {% elseif resource.description is not empty %}
                                        <gmd:description>
                                            <gco:CharacterString>{{ resource.description }}</gco:CharacterString>
                                        </gmd:description>
                                    {% endif %}
                                    {% if functions[resource.type] is defined %}
                                        <gmd:function>
                                            <gmd:CI_OnLineFunctionCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_OnLineFunctionCode" codeListValue="{{ functions[resource.type] }}">{{ functions[resource.type] }}</gmd:CI_OnLineFunctionCode>
                                        </gmd:function>
                                    {% endif %}
                                </gmd:CI_OnlineResource>
                            </gmd:onLine>
                        {% endfor %}
                    </gmd:MD_DigitalTransferOptions>
                </gmd:transferOptions>
            </gmd:MD_Distribution>
        </gmd:distributionInfo>
    {% endif %}

    {% if resource_genealogy is not empty %}
        <gmd:dataQualityInfo>
            <gmd:DQ_DataQuality>
                {# gmd:scope est obligatoire dans DQ_DataQuality #}
                <gmd:scope>
                    <gmd:DQ_Scope>
                        <gmd:level>
                            <gmd:MD_ScopeCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_ScopeCode" codeListValue="{{ hierarchy_level }}">{{ hierarchy_level }}</gmd:MD_ScopeCode>
                        </gmd:level>
                    </gmd:DQ_Scope>
                </gmd:scope>
                {# référence de conformité INSPIRE, comme la donneuse #}
                <gmd:report>
                    <gmd:DQ_DomainConsistency>
                        <gmd:nameOfMeasure>
                            <gco:CharacterString>Value domain conformance</gco:CharacterString>
                        </gmd:nameOfMeasure>
                        <gmd:result>
                            <gmd:DQ_ConformanceResult>
                                <gmd:specification>
                                    <gmd:CI_Citation>
                                        <gmd:title>
                                            <gco:CharacterString>Commission Regulation (EU) No 1089/2010 of 23 November 2010 implementing Directive 2007/2/EC of the European Parliament and of the Council as regards interoperability of spatial data sets and services</gco:CharacterString>
                                        </gmd:title>
                                        <gmd:date>
                                            <gmd:CI_Date>
                                                <gmd:date>
                                                    <gco:Date>2010-12-08</gco:Date>
                                                </gmd:date>
                                                <gmd:dateType>
                                                    <gmd:CI_DateTypeCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode" codeListValue="publication" />
                                                </gmd:dateType>
                                            </gmd:CI_Date>
                                        </gmd:date>
                                    </gmd:CI_Citation>
                                </gmd:specification>
                                <gmd:explanation>
                                    <gco:CharacterString>Dataset is conformant to the Inspire data specification.</gco:CharacterString>
                                </gmd:explanation>
                                <gmd:pass>
                                    <gco:Boolean>true</gco:Boolean>
                                </gmd:pass>
                            </gmd:DQ_ConformanceResult>
                        </gmd:result>
                    </gmd:DQ_DomainConsistency>
                </gmd:report>
                <gmd:lineage>
                    <gmd:LI_Lineage>
                        <gmd:statement>
                            <gco:CharacterString>{{ resource_genealogy }}</gco:CharacterString>
                        </gmd:statement>
                    </gmd:LI_Lineage>
                </gmd:lineage>
            </gmd:DQ_DataQuality>
        </gmd:dataQualityInfo>
    {% endif %}
</gmd:MD_Metadata>

{# éléments ci-dessus dans l’ordre des séquences ISO 19139 (MD_Metadata, MD_DataIdentification, CI_Address) #}
{% macro responsible_party(producer, role) %}
    <gmd:CI_ResponsibleParty>
        {% if producer.organization_name is not empty %}
            <gmd:organisationName>
                <gco:CharacterString>{{ producer.organization_name }}</gco:CharacterString>
            </gmd:organisationName>
        {% endif %}
        <gmd:contactInfo>
            <gmd:CI_Contact>
                <gmd:address>
                    <gmd:CI_Address>
                        {% if producer.address_number_and_streetname is not empty %}
                            <gmd:deliveryPoint>
                                <gco:CharacterString>{{ producer.address_number_and_streetname }}</gco:CharacterString>
                            </gmd:deliveryPoint>
                        {% endif %}
                        {% if producer.address_city is not empty %}
                            <gmd:city>
                                <gco:CharacterString>{{ producer.address_city }}</gco:CharacterString>
                            </gmd:city>
                        {% endif %}
                        {% if producer.address_postal_code is not empty %}
                            <gmd:postalCode>
                                <gco:CharacterString>{{ producer.address_postal_code }}</gco:CharacterString>
                            </gmd:postalCode>
                        {% endif %}
                        {% if producer.organization_email is not empty %}
                            <gmd:electronicMailAddress>
                                <gco:CharacterString>{{ producer.organization_email }}</gco:CharacterString>
                            </gmd:electronicMailAddress>
                        {% endif %}
                    </gmd:CI_Address>
                </gmd:address>
            </gmd:CI_Contact>
        </gmd:contactInfo>
        <gmd:role>
            <gmd:CI_RoleCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_RoleCode" codeListValue="{{ role }}">{{ role }}</gmd:CI_RoleCode>
        </gmd:role>
    </gmd:CI_ResponsibleParty>
{% endmacro %}
