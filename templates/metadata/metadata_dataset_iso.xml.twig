<?xml version="1.0" encoding="UTF-8"?><gmd:MD_Metadata xmlns:gmd="http://www.isotc211.org/2005/gmd" xmlns:gco="http://www.isotc211.org/2005/gco" xmlns:gml="http://www.opengis.net/gml" xmlns:gmx="http://www.isotc211.org/2005/gmx" xmlns:gsr="http://www.isotc211.org/2005/gsr" xmlns:gss="http://www.isotc211.org/2005/gss" xmlns:gts="http://www.isotc211.org/2005/gts" xmlns:srv="http://www.isotc211.org/2005/srv" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" {% if file_identifier is not empty %}uuid="{{ file_identifier }}" {% endif %}xsi:schemaLocation="http://www.isotc211.org/2005/gmd https://www.isotc211.org/2005/gmd/gmd.xsd http://www.isotc211.org/2005/gmx https://www.isotc211.org/2005/gmx/gmx.xsd http://www.isotc211.org/2005/srv http://schemas.opengis.net/iso/19139/20060504/srv/srv.xsd">
    {% if file_identifier is not empty %}
        <gmd:fileIdentifier>
            {# Identificateur de ressource unique #}
            <gco:CharacterString>{{ file_identifier }}</gco:CharacterString>
        </gmd:fileIdentifier>
    {% endif %}
    <gmd:language>
        <gmd:LanguageCode codeList="http://www.loc.gov/standards/iso639-2/" codeListValue="{{ language.code }}">{{ language.language }}</gmd:LanguageCode>
    </gmd:language>
    <gmd:characterSet>
        <gmd:MD_CharacterSetCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#MD_CharacterSetCode" codeListValue="{{ charset }}">{{ charset }}</gmd:MD_CharacterSetCode>
    </gmd:characterSet>
    <gmd:hierarchyLevel>
        <gmd:MD_ScopeCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#MD_ScopeCode" codeListValue="{{ hierarchy_level }}">{{ hierarchy_level }}</gmd:MD_ScopeCode>
    </gmd:hierarchyLevel>

    {# généalogie de la ressource #}
    {% set hierarchy_level_name = '' %}
    {% if hierarchy_level == 'dataset' %}
        {% set hierarchy_level_name = 'Jeu de données' %}
    {% elseif hierarchy_level == 'series' %}
        {% set hierarchy_level_name = 'Collection des données' %}
    {% endif %}

    <gmd:hierarchyLevelName>
        <gco:CharacterString>{{ hierarchy_level_name }}</gco:CharacterString>
    </gmd:hierarchyLevelName>

    {% if title is not empty or abstract is not empty or organisation_name is not empty or organisation_email is not empty or topic_categories|length or inspire_keywords|length or free_keywords|length or resolution is not empty or creation_date is not empty or thumbnail_url is not empty or frequency_code is not empty or bbox %}
        <gmd:identificationInfo>
            <gmd:MD_DataIdentification>
                {% if title is not empty %}
                    <gmd:citation>
                        <gmd:CI_Citation>
                            <gmd:title>
                                {# intitulé #}
                                <gco:CharacterString>{{ title }}</gco:CharacterString>
                            </gmd:title>

                            {% if creation_date is not empty %}
                                <gmd:date>
                                    <gmd:CI_Date>
                                        <gmd:date>
                                            <gco:Date>{{ creation_date }}</gco:Date>
                                        </gmd:date>
                                        <gmd:dateType>
                                            <gmd:CI_DateTypeCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#CI_DateTypeCode" codeListValue="creation">creation</gmd:CI_DateTypeCode>
                                        </gmd:dateType>
                                    </gmd:CI_Date>
                                </gmd:date>
                            {% endif %}
                        </gmd:CI_Citation>
                    </gmd:citation>
                {% endif %}

                {% if abstract is not empty %}
                    <gmd:abstract>
                        {# résumé #}
                        <gco:CharacterString>{{ abstract }}</gco:CharacterString>
                    </gmd:abstract>
                {% endif %}

                {% if organisation_email is not empty or organisation_name is not empty %}
                    {# email de contact sur les métadonnées #}
                    <gmd:pointOfContact>
                        <gmd:CI_ResponsibleParty>
                            {% if organisation_name is not empty %}
                                <gmd:organisationName>
                                    <gco:CharacterString>{{ organisation_name }}</gco:CharacterString>
                                </gmd:organisationName>
                            {% endif %}

                            {% if organisation_email is not empty %}
                                <gmd:contactInfo>
                                    <gmd:CI_Contact>
                                        <gmd:address>
                                            <gmd:CI_Address>
                                                <gmd:electronicMailAddress>
                                                    <gco:CharacterString>{{ organisation_email }}</gco:CharacterString>
                                                </gmd:electronicMailAddress>
                                            </gmd:CI_Address>
                                        </gmd:address>
                                    </gmd:CI_Contact>
                                </gmd:contactInfo>
                            {% endif %}
                        </gmd:CI_ResponsibleParty>
                    </gmd:pointOfContact>
                {% endif %}

                {% if inspire_keywords|length %}
                    <gmd:descriptiveKeywords>
                        <gmd:MD_Keywords>
                            {%- for item in inspire_keywords -%}
                                <gmd:keyword>
                                    <gco:CharacterString>{{ item }}</gco:CharacterString>
                                </gmd:keyword>
                            {%- endfor -%}
                            <gmd:thesaurusName>
                                <gmd:CI_Citation>
                                    <gmd:title>
                                        <gco:CharacterString>GEMET - INSPIRE themes, version 1.0</gco:CharacterString>
                                    </gmd:title>
                                    <gmd:date>
                                        <gmd:CI_Date>
                                            <gmd:date>
                                                <gco:Date>2008-06-01</gco:Date>
                                            </gmd:date>
                                            <gmd:dateType>
                                                <gmd:CI_DateTypeCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_DateTypeCode" codeListValue="publication" />
                                            </gmd:dateType>
                                        </gmd:CI_Date>
                                    </gmd:date>
                                </gmd:CI_Citation>
                            </gmd:thesaurusName>
                        </gmd:MD_Keywords>
                    </gmd:descriptiveKeywords>
                {% endif %}

                {% if free_keywords|length %}
                    <gmd:descriptiveKeywords>
                        <gmd:MD_Keywords>
                            {%- for item in free_keywords -%}
                                <gmd:keyword>
                                    <gco:CharacterString>{{ item }}</gco:CharacterString>
                                </gmd:keyword>
                            {%- endfor -%}
                            <gmd:type>
                                <gmd:MD_KeywordTypeCode codeList="http://standards.iso.org/ittf/PubliclyAvailableStandards/ISO_19139_Schemas/resources/codelist/ML_gmxCodelists.xml#MD_KeywordTypeCode" codeListValue="theme">theme</gmd:MD_KeywordTypeCode>
                            </gmd:type>
                        </gmd:MD_Keywords>
                    </gmd:descriptiveKeywords>
                {% endif %}

                {% if topic_categories|length %}
                    {% for topic in topic_categories %}
                        <gmd:topicCategory>
                            <gmd:MD_TopicCategoryCode>{{ topic }}</gmd:MD_TopicCategoryCode>
                        </gmd:topicCategory>
                    {% endfor %}
                {% endif %}

                {% if thumbnail_url %}
                    <gmd:graphicOverview>
                        <gmd:MD_BrowseGraphic>
                            <gmd:fileName>
                                <gco:CharacterString>{{ thumbnail_url }}</gco:CharacterString>
                            </gmd:fileName>
                            <gmd:fileDescription>
                                <gco:CharacterString>Aperçu</gco:CharacterString>
                            </gmd:fileDescription>
                            <gmd:fileType>
                                <gco:CharacterString>{{ thumbnail_url|split('.')|last }}</gco:CharacterString>
                            </gmd:fileType>
                        </gmd:MD_BrowseGraphic>
                    </gmd:graphicOverview>
                {% endif %}

                {% if frequency_code %}
                    <gmd:resourceMaintenance>
                        <gmd:MD_MaintenanceInformation>
                            <gmd:maintenanceAndUpdateFrequency>
                                <gmd:MD_MaintenanceFrequencyCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_MaintenanceFrequencyCode" codeListValue="{{ frequency_code }}" />
                            </gmd:maintenanceAndUpdateFrequency>
                        </gmd:MD_MaintenanceInformation>
                    </gmd:resourceMaintenance>
                {% endif %}

                {% if resolution %}
                    <gmd:spatialResolution>
                        <gmd:MD_Resolution>
                            <gmd:equivalentScale>
                                <gmd:MD_RepresentativeFraction>
                                    <gmd:denominator>
                                        <gco:Integer>{{ resolution }}</gco:Integer>
                                    </gmd:denominator>
                                </gmd:MD_RepresentativeFraction>
                            </gmd:equivalentScale>
                        </gmd:MD_Resolution>
                    </gmd:spatialResolution>
                {% endif %}

                {% if bbox %}
                    <gmd:extent>
                        <gmd:EX_Extent>
                            <gmd:geographicElement>
                                <gmd:EX_GeographicBoundingBox>
                                    <gmd:westBoundLongitude>
                                        <gco:Decimal>{{ bbox.west }}</gco:Decimal>
                                    </gmd:westBoundLongitude>
                                    <gmd:eastBoundLongitude>
                                        <gco:Decimal>{{ bbox.east }}</gco:Decimal>
                                    </gmd:eastBoundLongitude>
                                    <gmd:southBoundLatitude>
                                        <gco:Decimal>{{ bbox.south }}</gco:Decimal>
                                    </gmd:southBoundLatitude>
                                    <gmd:northBoundLatitude>
                                        <gco:Decimal>{{ bbox.north }}</gco:Decimal>
                                    </gmd:northBoundLatitude>
                                </gmd:EX_GeographicBoundingBox>
                            </gmd:geographicElement>
                        </gmd:EX_Extent>
                    </gmd:extent>
                {% endif %}

                <gmd:spatialRepresentationType>
                    <gmd:MD_SpatialRepresentationTypeCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_SpatialRepresentationTypeCode" codeListValue="vector" />
                </gmd:spatialRepresentationType>
            </gmd:MD_DataIdentification>
        </gmd:identificationInfo>
    {% endif %}

    {% if contact_email is not empty %}
        {# responsable de la ressource #}
        <gmd:contact>
            <gmd:CI_ResponsibleParty>
                <gmd:contactInfo>
                    <gmd:CI_Contact>
                        <gmd:address>
                            <gmd:CI_Address>
                                <gmd:electronicMailAddress>
                                    <gco:CharacterString>{{ contact_email }}</gco:CharacterString>
                                </gmd:electronicMailAddress>
                            </gmd:CI_Address>
                        </gmd:address>
                    </gmd:CI_Contact>
                </gmd:contactInfo>
            </gmd:CI_ResponsibleParty>
        </gmd:contact>
    {% endif %}

    <gmd:dateStamp>
        <gco:DateTime>{{ date_stamp }}</gco:DateTime>
    </gmd:dateStamp>

    {% if resource_genealogy is not empty %}
        <gmd:dataQualityInfo>
            <gmd:DQ_DataQuality>
                <gmd:lineage>
                    <gmd:LI_Lineage>
                        <gmd:statement>
                            <gco:CharacterString>{{ resource_genealogy }}</gco:CharacterString>
                        </gmd:statement>
                    </gmd:LI_Lineage>
                </gmd:lineage>
            </gmd:DQ_DataQuality>
        </gmd:dataQualityInfo>
    {% endif %}

    {% if online_resources|length %}
        <gmd:distributionInfo>
            <gmd:MD_Distribution>
                <gmd:transferOptions>
                    <gmd:MD_DigitalTransferOptions>
                        {# https://cnig.gouv.fr/IMG/pdf/guide_recherche_inspire.pdf #}
                        {# linkage : adresse de la ressource ; protocol : nature de la ressource (OGC:WMS, OGC:WFS, OGC:WMTS, TMS pour une couche ; vocabulaire OSGeo pour les fichiers) ; name : nom de la couche ou du fichier #}
                        {% set functions = {style: 'download', capabilities: 'information', document: 'information'} %}
                        {% for resource in online_resources %}
                            <gmd:onLine>
                                <gmd:CI_OnlineResource>
                                    <gmd:linkage>
                                        <gmd:URL>{{ resource.url }}</gmd:URL>
                                    </gmd:linkage>
                                    {% if resource.protocol is not empty %}
                                        <gmd:protocol>
                                            <gco:CharacterString>{{ resource.protocol }}</gco:CharacterString>
                                        </gmd:protocol>
                                    {% endif %}
                                    {% if resource.type == 'layer' and not resource.open %}
                                        <gmd:applicationProfile>
                                            <gmx:Anchor xlink:href="http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/other">other</gmx:Anchor>
                                        </gmd:applicationProfile>
                                    {% endif %}
                                    <gmd:name>
                                        <gco:CharacterString>{{ resource.name }}</gco:CharacterString>
                                    </gmd:name>
                                    {% if resource.type == 'layer' and not resource.open %}
                                        <gmd:description>
                                            <gmx:Anchor xlink:href="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#MD_RestrictionCode_restricted">{{ resource.description ?: resource.name ~ ' - Accès restreint' }}</gmx:Anchor>
                                        </gmd:description>
                                    {% elseif resource.description is not empty %}
                                        <gmd:description>
                                            <gco:CharacterString>{{ resource.description }}</gco:CharacterString>
                                        </gmd:description>
                                    {% endif %}
                                    {% if functions[resource.type] is defined %}
                                        <gmd:function>
                                            <gmd:CI_OnLineFunctionCode codeList="http://standards.iso.org/iso/19139/resources/gmxCodelists.xml#CI_OnLineFunctionCode" codeListValue="{{ functions[resource.type] }}">{{ functions[resource.type] }}</gmd:CI_OnLineFunctionCode>
                                        </gmd:function>
                                    {% endif %}
                                </gmd:CI_OnlineResource>
                            </gmd:onLine>
                        {% endfor %}
                    </gmd:MD_DigitalTransferOptions>
                </gmd:transferOptions>
            </gmd:MD_Distribution>
        </gmd:distributionInfo>
    {% endif %}
</gmd:MD_Metadata>
