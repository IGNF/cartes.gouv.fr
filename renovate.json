{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "frankenphp (dépôt deb henderkes) : suit les builds de la version PHP extraite de frankenphp_version, le bump PHP reste manuel",
            "managerFilePatterns": ["/\\.docker/Dockerfile$/"],
            "matchStrings": ["ARG frankenphp_version=(?<currentValue>[\\d.]+\\+php(?<phpVersion>\\d+)[\\d.+a-z-]*)"],
            "depNameTemplate": "frankenphp",
            "datasourceTemplate": "deb",
            "registryUrlTemplate": "https://pkg.henderkes.com/api/packages/{{phpVersion}}/debian?suite=php-zts&components=main&binaryArch=amd64"
        },
        {
            "customType": "regex",
            "description": "php-zts-embed/cli (dépôt deb henderkes) : correctifs PHP de la branche extraite de php_zts_version, le bump de branche reste manuel",
            "managerFilePatterns": ["/\\.docker/Dockerfile$/"],
            "matchStrings": ["ARG php_zts_version=(?<currentValue>(?<phpMajor>\\d+)\\.(?<phpMinor>\\d+)\\.\\d+-\\d+)"],
            "depNameTemplate": "php-zts-embed",
            "datasourceTemplate": "deb",
            "registryUrlTemplate": "https://pkg.henderkes.com/api/packages/{{phpMajor}}{{phpMinor}}/debian?suite=php-zts&components=main&binaryArch=amd64"
        }
    ],
    "packageRules": [
        {
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Node : .nvmrc et les ARG node du Dockerfile dans une même PR",
            "groupName": "node",
            "matchPackageNames": ["node", "docker.io/library/node"]
        }
    ]
}
