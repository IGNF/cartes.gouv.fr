{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "frankenphp (dépôt deb henderkes) : version amont nue dans le Dockerfile, branche PHP lue sur php_zts_version ; le suffixe de rebuild du dépôt est ignoré",
            "managerFilePatterns": ["/\\.docker/Dockerfile$/"],
            "matchStringsStrategy": "combination",
            "matchStrings": ["ARG php_zts_version=(?<phpMajor>\\d+)\\.(?<phpMinor>\\d+)\\.", "ARG frankenphp_version=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
            "depNameTemplate": "frankenphp",
            "datasourceTemplate": "deb",
            "registryUrlTemplate": "https://pkg.henderkes.com/api/packages/{{phpMajor}}{{phpMinor}}/debian?suite=php-zts&components=main&binaryArch=amd64",
            "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)"
        },
        {
            "customType": "regex",
            "description": "php-zts-embed/cli et extensions (dépôt deb henderkes) : correctifs PHP de la branche extraite de php_zts_version, le bump de branche reste manuel ; le suffixe de rebuild du dépôt est ignoré",
            "managerFilePatterns": ["/\\.docker/Dockerfile$/"],
            "matchStrings": ["ARG php_zts_version=(?<currentValue>(?<phpMajor>\\d+)\\.(?<phpMinor>\\d+)\\.\\d+)"],
            "depNameTemplate": "php-zts-embed",
            "datasourceTemplate": "deb",
            "registryUrlTemplate": "https://pkg.henderkes.com/api/packages/{{phpMajor}}{{phpMinor}}/debian?suite=php-zts&components=main&binaryArch=amd64",
            "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)"
        }
    ],
    "packageRules": [
        {
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Node : .nvmrc et les ARG node du Dockerfile dans une même PR",
            "groupName": "node",
            "matchPackageNames": ["node", "docker.io/library/node"]
        }
    ]
}
