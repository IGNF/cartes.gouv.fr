{
	frankenphp {
		# Épinglé : le défaut (2 x CPU) lirait les coeurs du noeud - voir docs/developer/dimensionnement.md
		num_threads {$FRANKENPHP_NUM_THREADS:4}

		# Threads à la demande pour absorber les pics - voir docs/developer/dimensionnement.md
		max_threads {$FRANKENPHP_MAX_THREADS:8}

		# Worker mode (PR ultérieure ; nécessitera runtime/frankenphp-symfony)
		# worker /opt/cartesgouvfr-site/public/index.php
	}

	# TLS terminé par le reverse proxy amont
	auto_https off

	# Conteneur immutable : pas de reload de config, l'endpoint d'admin est inutile
	admin off

	# Ne sert que le client_ip des access logs ; REMOTE_ADDR et la résolution Symfony (TRUSTED_PROXIES) inchangés
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}

	# Logs en texte brut ; level_format upper évite les codes couleur ANSI
	log {
		format console {
			level_format upper
		}
	}

	# Laisser au plus 25 s aux requêtes en cours à l'arrêt (drain infini par défaut)
	grace_period 25s

	# respond (405 TRACE) doit passer avant les redirections
	order respond before redir
}

:8000 {
	root * /opt/cartesgouvfr-site/public

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
		-X-Powered-By
	}

	# Assets Vite hashés ; file : sans lui, la page HTML renvoyée pour un asset disparu serait cachée 1 an
	@build {
		path /build/*
		file
	}
	header @build Cache-Control "public, max-age=31536000, immutable"

	# Statiques à nom fixe, cache modéré avec revalidation ; file : même garde que @build
	@static {
		path /favicon/* /bundles/* /favicon.ico /robots.txt
		file
	}
	header @static Cache-Control "public, max-age=86400, must-revalidate"

	# Équivalent du TraceEnable Off d'Apache
	@trace method TRACE
	respond @trace 405

	# .ht* jamais servis : réécrits vers un chemin inexistant, donc 404 React du front controller
	@hidden path */.ht*
	rewrite @hidden /__fichier-cache__

	# Redirections héritées du vhost Apache, query string préservée ; tout ajout
	# doit aussi être exclu du matcher @phpHandled, sinon il ne sera pas loggé
	redir / /explorer-les-cartes{?query} 301
	@faq path /faq /faq/
	redir @faq /aide/fr{?query} 301
	@apropos path /a-propos /a-propos/
	redir @apropos /decouvrir{?query} 301
	@nousecrire path /nous-ecrire /nous-ecrire/
	redir @nousecrire /aide/fr/nous-ecrire{?query} 301
	@offre path /offre /offre/
	redir @offre /offres{?query} 301

	# Canonicalisation /index.php → URL propre (parité avec public/.htaccess)
	@indexphp path_regexp idx ^/index\.php(?:/(.*))?$
	redir @indexphp /{re.idx.1}{?query} 301

	# Probes de santé jamais loggées ; filet si le log_skip @phpHandled est retiré (rollback)
	@health path_regexp ^/tableau-de-bord/(health|ready)/?$
	log_skip @health

	# Requêtes dynamiques loggées par Symfony (docs/developer/logs.md), Caddy ne logge que ce qu'il sert lui-même
	# /files/* (passerelle S3) reste loggé ici : PHP répond avant l'appel S3, seul Caddy connaît le statut final
	@phpHandled {
		not file
		not path / /faq /faq/ /a-propos /a-propos/ /nous-ecrire /nous-ecrire/ /offre /offre/ /index.php /index.php/* /files/*
		not method TRACE
	}
	log_skip @phpHandled

	# public/.htaccess est un fichier : @phpHandled ne le saute pas, Symfony le loggerait en double
	log_skip @hidden

	# Seuls les headers recopiés ici apparaissent dans l'access log (allowlist) ; header absent = chaîne vide
	log_append user_agent {header.User-Agent}
	log_append referer {header.Referer}
	log_append request_id {header.X-Request-Id}

	log {
		output stdout
		format filter {
			wrap console {
				level_format upper
				duration_format ms
			}
			fields {
				# headers supprimés en bloc, recopiés au cas par cas via log_append
				request>headers delete
				# referer sans query string (même minimisation que la ligne d'accès applicative)
				referer regexp \?.* ""
				# client_ip suffit : remote_ip = ingress
				request>remote_ip delete
				request>remote_port delete
				request>proto delete
				bytes_read delete
				user_id delete
				resp_headers delete
			}
		}
	}

	# Passerelle S3 (docs/developer/passerelle-s3.md) : Caddy demande à PHP de valider la clé et de signer la requête
	# (sous-requête /s3-sign/files/... vers le serveur interne ci-dessous), puis relaie l'URL du client telle quelle
	# vers le S3, encodage compris (un « + » ré-encodé serait lu comme une espace par le S3). Sortie HTTPS via HTTPS_PROXY.
	# La route de signature n'existe que pour le serveur interne : bloquée ici, Symfony ne sachant pas d'où vient l'appel
	@s3SignPublic path /s3-sign/*
	respond @s3SignPublic 404

	# /files et /files/ (clé vide) restent hors passerelle : page React, comme toute URL inconnue
	@s3Gateway {
		path /files/*
		not path /files/
		method GET HEAD
	}
	route @s3Gateway {
		# En-têtes x-amz et Via (ajouté par reverse_proxy, révèle Caddy) jamais renvoyés ; placé en tête car route garde l'ordre écrit
		header -Via
		header -x-amz-*

		# 2xx = clé valide, signature dans les en-têtes X-S3-* recopiés sur la requête ; sinon la réponse PHP (404, 301) est renvoyée
		forward_auth 127.0.0.1:8081 {
			uri /s3-sign{http.request.uri.path}
			copy_headers X-S3-Algorithm X-S3-Credential X-S3-Date X-S3-Expires X-S3-Content-Sha256 X-S3-Signedheaders X-S3-Signature
		}

		# Chemin du client conservé (uri replace garde l'encodage brut, contrairement à rewrite) ; query signée reconstituée
		# paramètre par paramètre, rewrite encode chaque valeur
		uri replace /files/ /{$S3_BUCKET_NAME}/
		rewrite * ?X-Amz-Algorithm={http.request.header.X-S3-Algorithm}&X-Amz-Credential={http.request.header.X-S3-Credential}&X-Amz-Date={http.request.header.X-S3-Date}&X-Amz-Expires={http.request.header.X-S3-Expires}&X-Amz-Content-Sha256={http.request.header.X-S3-Content-Sha256}&X-Amz-SignedHeaders={http.request.header.X-S3-Signedheaders}&X-Amz-Signature={http.request.header.X-S3-Signature}

		# Cache uniquement sur les réponses réussies du S3, jamais sur une erreur ni une redirection
		header {
			match {
				status 200 206 304
			}
			Cache-Control "public, max-age=3600, must-revalidate, s-maxage=3600"
		}

		reverse_proxy {$S3_ENDPOINT} {
			# Host du S3 sans port, tel que signé par PHP (SigV4) ; signature et en-têtes d'authentification du navigateur
			# jamais transmis
			header_up Host {http.reverse_proxy.upstream.host}
			header_up -X-S3-*
			header_up -Cookie
			header_up -Authorization

			# S3 muet : le client n'attend pas indéfiniment les en-têtes de réponse
			transport http {
				response_header_timeout 30s
			}

			# Réponses d'erreur S3 renvoyées vides (pas de XML ni de nom de bucket) et jamais mises en cache.
			# 404, 412 (If-Match, If-Unmodified-Since) et 416 (Range) gardent leur statut ; le reste,
			# dont 403 (identifiants invalides), devient 502
			@missing status 404
			handle_response @missing {
				header Cache-Control "no-cache, private"
				respond 404
			}
			@precondition status 412
			handle_response @precondition {
				header Cache-Control "no-cache, private"
				respond 412
			}
			@range status 416
			handle_response @range {
				header Cache-Control "no-cache, private"
				copy_response_headers {
					include Content-Range
				}
				respond 416
			}
			@failed status 4xx 5xx
			handle_response @failed {
				header Cache-Control "no-cache, private"
				respond 502
			}
		}
	}

	# Erreurs générées par Caddy lui-même (amont injoignable ou muet) : réponse vide, sans en-tête Server
	handle_errors 502 504 {
		header -Server
		header Cache-Control "no-cache, private"
		respond "" {err.status_code}
	}

	php_server
}

# Serveur interne de la passerelle S3 (route /s3-sign/files/...) : lié à la boucle locale, joignable uniquement par
# forward_auth, jamais loggé. Adresse sans hôte : la sous-requête garde le Host du client
http://:8081 {
	bind 127.0.0.1
	root * /opt/cartesgouvfr-site/public
	php_server
}
